<div class="bf-auth-description">Tạo mật khẩu mới cho tài khoản của bạn.</div>
{{#if error}}{{> feedback/alert type="error" title="Không thể đặt lại mật khẩu" message=error}}{{/if}}
{{#if success}}{{> feedback/alert type="success" message=success}}{{/if}}
<form class="bf-auth-form" method="post" action="/auth/dat-lai-mat-khau" data-bf-auth-form>
    <input type="hidden" name="token" value="{{token}}">
    {{#if requiresOtp}}
        {{> forms/input id="reset-code" name="code" type="text" label="Mã xác thực" value=values.code placeholder="Nhập mã gồm 6 chữ số" autocomplete="one-time-code" maxlength="6" minlength="6" className="bf-auth-otp-field"}}
    {{/if}}
    {{> forms/password id="new-password" name="newPassword" label="Mật khẩu mới" placeholder="Nhập mật khẩu mới" autocomplete="new-password" required=true minlength="8"}}
    {{> forms/password id="confirm-new-password" name="confirmNewPassword" label="Xác nhận mật khẩu mới" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" required=true}}
    <div class="bf-form-error bf-auth-password-error" data-password-error hidden>Mật khẩu xác nhận chưa khớp.</div>
    <div class="bf-auth-submit">
        <button class="bf-btn bf-btn-primary bf-btn-md" type="submit" data-auth-submit>Đặt lại mật khẩu</button>
        {{> common/loading visible=false fullscreen=false text="Đang cập nhật mật khẩu..." className="bf-auth-loading"}}
    </div>
</form>
<p class="bf-auth-switch"><a href="/auth/dang-nhap">Quay lại đăng nhập</a></p>