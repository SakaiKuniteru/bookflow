<div class="bf-auth-description">Vui lòng nhập mã xác nhận đã được gửi đến email của bạn.</div>
<form class="bf-auth-form" method="post" action="/auth/xac-minh-dang-ky" data-bf-auth-form data-api-endpoint="/api/xac-thuc/xac-nhan-dang-ky" data-api-success-url="/auth/dang-nhap?registered=1" data-auth-loading-text="Đang xác minh...">
    <input type="hidden" name="email" value="{{email}}">
    <div class="bf-auth-email-summary">
        <span class="bf-input-leading-icon">
            {{> ui/icon
                name="email"
                size=18
            }}
        </span>
        <strong>{{email}}</strong>
        <a href="{{changeEmailUrl}}">Thay đổi thông tin</a>
    </div>
    {{> forms/otp
        name="otp"
        value=otp
        label="Mã xác nhận"
        error=otpError
    }}
    <p class="bf-auth-otp-help">Mã có hiệu lực trong 5 phút.</p>
    <div class="bf-auth-submit">
        <button class="bf-btn bf-btn-primary bf-btn-md" type="submit" data-auth-submit>Xác nhận <span aria-hidden="true">→</span></button>
    </div>
</form>
<div class="bf-auth-divider"><span>Chưa nhận được mã?</span></div>
<form class="bf-auth-form bf-auth-resend-form" method="post" action="/auth/gui-lai-otp-dang-ky" data-bf-auth-form data-auth-loading-text="Đang gửi lại mã...">
    <input type="hidden" name="email" value="{{email}}">
    <button class="bf-auth-text-action" type="submit" data-auth-resend-button>
        <span data-auth-resend-label>Gửi lại mã</span>
        <span data-auth-countdown hidden></span>
        <span aria-hidden="true">⟳</span>
    </button>
</form>
{{#if resendError}}<div class="bf-form-error bf-auth-resend-error" role="alert">{{resendError}}</div>{{/if}}
<p class="bf-auth-switch"><a href="/auth/dang-nhap">Quay lại đăng nhập</a></p>