<div class="bf-auth-description">Tạo tài khoản để sử dụng các dịch vụ của BookFlow.</div>
    {{#if formError}}
        <div class="bf-form-error" role="alert">{{formError}}</div>
    {{/if}}
<form class="bf-auth-form" method="post" action="/auth/dang-ky" data-bf-auth-form data-auth-loading-text="Đang tạo tài khoản...">
    {{#if resumeRegistration}}<input type="hidden" name="resumeRegistration" value="1">{{/if}}
    {{> forms/input
        id="register-full-name"
        name="fullName"
        type="text"
        label="Họ và tên"
        value=values.fullName
        placeholder="Nhập họ và tên"
        autocomplete="name"
        icon="user"
        required=true
        error=fieldErrors.fullName
    }}
    {{> forms/input
        id="register-username"
        name="username"
        type="text"
        label="Tên đăng nhập"
        value=values.username
        placeholder="Nhập tên đăng nhập"
        autocomplete="username"
        icon="user"
        required=true
        error=fieldErrors.username
    }}
    {{> forms/email
        id="register-email"
        name="email"
        label="Email"
        value=values.email
        placeholder="name@example.com"
        icon="email"
        required=true
        error=fieldErrors.email
    }}
    {{> forms/phone
        id="register-phone"
        name="phone"
        label="Số điện thoại"
        value=values.phone
        placeholder="Nhập số điện thoại"
        icon="phone"
        required=true
        error=fieldErrors.phone
    }}
    {{> forms/password
        id="register-password"
        name="password"
        label="Mật khẩu"
        value=values.password
        placeholder="Tạo mật khẩu"
        autocomplete="new-password"
        icon="lock"
        required=true
        minlength="8"
        pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9\s])[^\r\n]{8,128}"
    }}
    {{> forms/password
        id="register-password-confirm"
        name="passwordConfirm"
        label="Xác nhận mật khẩu"
        value=values.passwordConfirm
        placeholder="Nhập lại mật khẩu"
        autocomplete="new-password"
        icon="lock"
        required=true
    }}
    <div class="bf-form-error bf-auth-password-error" data-password-error hidden>Mật khẩu xác nhận chưa khớp.</div>
    {{> forms/checkbox
        id="accept-terms"
        name="acceptTerms"
        label="Tôi đồng ý với điều khoản sử dụng và chính sách quyền riêng tư."
        value="true"
        checked=values.acceptTerms
        required=true
        error=fieldErrors.acceptTerms
    }}
    <div class="bf-auth-submit">
        <button class="bf-btn bf-btn-primary bf-btn-md" type="submit" data-auth-submit>Đăng ký <span aria-hidden="true">→</span></button>
    </div>
</form>
<p class="bf-auth-switch">Đã có tài khoản? <a href="/auth/dang-nhap">Đăng nhập</a></p>