<article class="bf-book-card">
    <a class="bf-book-card-cover" href="{{#if book.href}}{{book.href}}{{else}}#{{/if}}" {{#unless book.href}}aria-disabled="true" tabindex="-1"{{/unless}}>
        {{#if book.coverUrl}}
            <img src="{{book.coverUrl}}" alt="{{#if book.coverAlt}}{{book.coverAlt}}{{else}}Bìa sách {{book.title}}{{/if}}" loading="lazy">
        {{else}}
            <span class="bf-book-card-cover-empty">Chưa có ảnh bìa</span>
        {{/if}}
    </a>
    <div class="bf-book-card-content">
        <div class="bf-book-card-heading">
            <div>
                {{#if book.href}}<a class="bf-book-card-title" href="{{book.href}}">{{book.title}}</a>{{else}}<h3 class="bf-book-card-title">{{book.title}}</h3>{{/if}}
                {{#if book.subtitle}}<p class="bf-book-card-subtitle">{{book.subtitle}}</p>{{/if}}
            </div>
            {{#if book.statusLabel}}
                {{> components/sach/trang-thai-sach statusCode=book.statusCode label=book.statusLabel variant=book.statusVariant icon=book.statusIcon tooltip=book.statusTooltip}}
            {{/if}}
        </div>
        {{#if book.authorsDisplay}}<p class="bf-book-card-meta"><span>Tác giả</span><strong>{{book.authorsDisplay}}</strong></p>{{/if}}
        {{#if book.isbn}}<p class="bf-book-card-meta"><span>ISBN</span><strong>{{book.isbn}}</strong></p>{{/if}}
        {{#if book.categoryName}}<p class="bf-book-card-meta"><span>Thể loại</span><strong>{{book.categoryName}}</strong></p>{{/if}}
        {{#if book.publisherName}}<p class="bf-book-card-meta"><span>Nhà xuất bản</span><strong>{{book.publisherName}}</strong></p>{{/if}}
        {{#if book.publishedYear}}<p class="bf-book-card-meta"><span>Năm xuất bản</span><strong>{{book.publishedYear}}</strong></p>{{/if}}
        {{#if book.provisions}}
            {{> components/sach/hinh-thuc-cung-cap types=book.provisions ariaLabel="Hình thức cung cấp"}}
        {{/if}}
        {{#if book.priceDisplay}}<p class="bf-book-card-price"><span>Giá bán</span><strong>{{book.priceDisplay}}</strong></p>{{/if}}
        {{#if book.rentalPriceDisplay}}<p class="bf-book-card-price"><span>Giá thuê</span><strong>{{book.rentalPriceDisplay}}</strong></p>{{/if}}
        {{#if book.stockDisplay}}<p class="bf-book-card-stock"><span>Tồn kho</span><strong>{{book.stockDisplay}}</strong></p>{{/if}}
        {{#if book.actions}}
            <div class="bf-book-card-actions">
                {{#each book.actions}}
                    {{#if href}}<a class="bf-button bf-button--{{#if variant}}{{variant}}{{else}}secondary{{/if}}" href="{{href}}">{{label}}</a>{{else}}<button class="bf-button bf-button--{{#if variant}}{{variant}}{{else}}secondary{{/if}}" type="button" data-action="{{action}}">{{label}}</button>{{/if}}
                {{/each}}
            </div>
        {{/if}}
    </div>
</article>