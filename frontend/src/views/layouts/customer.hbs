<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#173e37">
    <title>{{#if title}}{{title}} | {{/if}}{{app.name}}</title>
    <link rel="icon" href="/brand/logo-symbol.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/components/tables.css">
    <link rel="stylesheet" href="/css/components/forms.css?v=20261001-2">
    <link rel="stylesheet" href="/css/components/navigation.css">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/pages/public.css">
    {{#each stylesheets}}
        <link rel="stylesheet" href="{{this}}">
    {{/each}}
</head>
<body class="bf-layout bf-layout-customer" data-bf-theme="default">
    {{> navigation/header
        publicNav=true
        brandName=app.name
        brandHref="/"
        links=navigation.headerLinks
        user=user
        accountLinks=navigation.accountLinks
        notifications=navigation.notifications
        unreadCount=navigation.unreadCount
        showNotifications=navigation.showNotifications
        sidebarId="customer-sidebar"
    }}
    <main id="main-content" class="bf-layout-content bf-demo-main">{{{body}}}</main>
    <footer class="bf-demo-footer">
        <a class="bf-nav-brand bf-demo-brand" href="/">
            <span class="bf-demo-mark" aria-hidden="true"><i></i></span>
            <span>{{app.name}}</span>
            <small>AI</small>
        </a>
        <span>BookFlow AI · Bán sách · Mượn miễn phí · Thuê có phí · Hội viên</span>
    </footer>
    <script type="module" src="/js/components/forms.js?v=20261001-7"></script>
    <script type="module" src="/js/page/auth.js?v=20261001-5"></script>
    {{#if authenticated}}<script defer src="/js/common/session-keepalive.js?v=20261004-1"></script>{{/if}}
    <script type="module" src="/js/components/navigation.js?v=20260930-1"></script>
    {{#each scripts}}
        <script type="module" src="{{this}}"></script>
    {{/each}}
</body>
</html>