<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#173e37">
    {{#if authenticated}}<meta name="bf-access-token" content="{{bfAccessToken}}"><script src="/js/common/bearer-fetch.js?v=20261005-1"></script>{{/if}}
    <title>{{#if title}}{{title}} | {{/if}}{{app.name}}</title>
    <link rel="icon" href="/brand/logo-symbol.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/components/tables.css">
    <link rel="stylesheet" href="/css/components/forms.css?v=20261001-2">
    <link rel="stylesheet" href="/css/components/navigation.css">
    <link rel="stylesheet" href="/css/theme.css">
    {{#each stylesheets}}
        <link rel="stylesheet" href="{{this}}">
    {{/each}}
</head>
<body class="bf-layout bf-layout-staff {{bodyClass}}" data-bf-theme="default">
    <button type="button" class="bf-nav-mobile-toggle bf-layout-sidebar-toggle" data-bf-sidebar-toggle="staff-sidebar" aria-label="Mở menu" aria-expanded="false">
        {{> ui/icon name="menu" size="22"}}
    </button>
    <div class="bf-app-shell">
        {{> navigation/sidebar
            id="staff-sidebar"
            title=navigation.sidebarTitle
            ariaLabel="Menu nhân viên"
            items=navigation.sidebarItems
            dashboardHref="/staff/tong-quan"
            profileHref="/staff/thong-tin-ca-nhan"
            user=user
        }}
        <div class="bf-app-main">
            {{#if breadcrumbs}}
                <div class="bf-layout-container">
                    {{> navigation/breadcrumb
                        items=breadcrumbs
                    }}
                </div>
            {{/if}}
            <main id="main-content" class="bf-layout-content {{contentClass}}">{{{body}}}</main>
            {{#if navigation.footerGroups}}
                {{> navigation/footer
                    brandName=app.name
                    groups=navigation.footerGroups
                    bottomLinks=navigation.footerLinks
                    copyright=navigation.copyright
                    year=navigation.year
                }}
            {{/if}}
        </div>
    </div>
    <script type="module" src="/js/components/forms.js?v=20261001-7"></script>
    <script type="module" src="/js/page/auth.js?v=20261001-5"></script>
    {{#if authenticated}}<script defer src="/js/common/session-keepalive.js?v=20261004-1"></script>{{/if}}
    <script type="module">import { initNavigation } from "/js/components/navigation.js"; initNavigation();</script>
    {{#each scripts}}
        <script type="module" src="{{this}}"></script>
    {{/each}}
    <script defer src="/js/common/auth-sync.js?v=20261004-2"></script>
</body>
</html>