<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0f4b40">
    {{#if authenticated}}<meta name="bf-access-token" content="{{bfAccessToken}}">{{/if}}<script src="/js/common/bearer-fetch.js?v=20261006-1"></script>
    <title>{{#if title}}{{title}} | {{/if}}{{app.name}}</title>
    <link rel="icon" href="{{app.logoUrl}}">
    <link rel="stylesheet" href="/css/components/forms.css?v=20261001-2">
    <link rel="stylesheet" href="/css/components/navigation.css?v=20261009-responsive-brand-1">
    <link rel="stylesheet" href="/css/theme.css?v=20261009-responsive-brand-1">
    <link rel="stylesheet" href="/css/components/modals.css">
    <link rel="stylesheet" href="/css/pages/auth.css?v=20261009-responsive-brand-1">
    {{#each stylesheets}}
        <link rel="stylesheet" href="{{this}}">
    {{/each}}
</head>
<body class="bf-layout bf-layout-auth {{#if sessionSetup}}bf-auth-session-setup{{/if}} {{bodyClass}}" data-bf-theme="default" data-bf-app-name="{{app.name}}" data-bf-app-logo="{{app.logoUrl}}" data-auth-page="{{authPage}}" data-auth-code-sent="{{#if codeSent}}true{{else}}false{{/if}}" data-login-failed="{{#if loginFailed}}true{{else}}false{{/if}}">
    <main id="main-content" class="bf-auth-main">
        <section class="bf-auth-story" aria-label="Giới thiệu {{app.name}}">
            <header class="bf-auth-header">
                <a class="bf-auth-brand" href="/" aria-label="{{app.name}} - Trang chủ">
                    <img class="bf-auth-brand-image" src="{{app.logoUrl}}" alt="">
                    <span class="bf-nav-brand-name" title="{{app.name}}">{{app.name}}</span>
                </a>
            </header>
            <div class="bf-auth-story-copy">
                <div class="bf-auth-eyebrow">Quản lý sách · Kết nối tri thức</div>
                <span class="bf-auth-eyebrow-line"></span>
                <h2>Chào mừng bạn<br>đến với {{app.name}}</h2>
                {{#if (eq title "Đăng ký")}}
                    <p>Đăng ký tài khoản để bắt đầu hành trình quản lý<br>và khám phá thế giới sách, tri thức.</p>
                {{else if (eq title "Xác minh email")}}
                    <p>Để bảo mật tài khoản của bạn, vui lòng xác nhận địa chỉ email. Mã xác nhận đã được gửi đến email của bạn.</p>
                {{else if (eq title "Quên mật khẩu")}}
                    <p>Chúng tôi sẽ giúp bạn lấy lại quyền truy cập và tiếp tục hành trình khám phá tri thức.</p>
                {{else if (eq title "Đặt lại mật khẩu")}}
                    <p>Xác minh tài khoản của bạn và tạo mật khẩu mới để tiếp tục sử dụng {{app.name}}.</p>
                {{else}}
                    <p>Đăng nhập để tiếp tục sử dụng {{app.name}}<br>và khám phá thế giới sách, tri thức.</p>
                {{/if}}
            </div>
            <img class="bf-auth-illustration" src="/images/auth-library.svg" alt="Minh họa sách và tri thức" aria-hidden="true">
            <div class="bf-auth-benefits">
                <div class="bf-auth-benefit">
                    <span class="bf-auth-benefit-icon">
                        {{> ui/icon
                            name="book"
                            size=29
                        }}
                    </span>
                    <strong>Quản lý dễ dàng</strong>
                    <span>Tối ưu vận hành<br>hiệu quả</span>
                </div>
                <div class="bf-auth-benefit">
                    <span class="bf-auth-benefit-icon">
                        {{> ui/icon
                            name="chart"
                            size=29
                        }}
                    </span>
                    <strong>Báo cáo trực quan</strong>
                    <span>Nắm bắt tình hình<br>nhanh chóng</span>
                </div>
                <div class="bf-auth-benefit">
                    <span class="bf-auth-benefit-icon">
                        {{> ui/icon
                            name="shield"
                            size=29
                        }}
                    </span>
                    <strong>Bảo mật an toàn</strong>
                    <span>Dữ liệu luôn được<br>bảo vệ</span>
                </div>
            </div>
        </section>
        <section class="bf-auth-card {{#if (eq title "Đăng nhập")}}bf-auth-card-login{{else if (eq title "Xác minh email")}}bf-auth-card-otp{{else if (eq title "Đặt lại mật khẩu")}}bf-auth-card-otp{{else if (eq title "Quên mật khẩu")}}bf-auth-card-forgot{{/if}}" aria-labelledby="auth-title">
            <div class="bf-auth-card-mark" aria-hidden="true">
                {{#if (eq title "Xác minh email")}}
                    <svg viewBox="0 0 64 64">
                        <path d="M7 14h38a6 6 0 0 1 6 6v25a5 5 0 0 1-5 5H9a6 6 0 0 1-6-6V20a6 6 0 0 1 4-6Z"></path>
                        <path d="m5 19 21 16 21-16"></path>
                        <path d="m48 39 7 3v8c0 6-4 10-7 12-4-2-7-6-7-12v-8l7-3Z"></path>
                        <path d="m45 50 2 2 4-5"></path>
                    </svg>
                {{else}}
                    {{> ui/icon
                        name="book"
                        size=54
                    }}
                {{/if}}
            </div>
            {{#if title}}<h1 id="auth-title" class="bf-auth-title">{{title}}</h1>{{/if}}
            {{{body}}}
            {{#if footerText}}<p class="bf-auth-footer">{{footerText}}</p>{{/if}}
        </section>
    </main>
    <script type="module" src="/js/components/forms.js?v=20261009-1"></script>
    <script type="module" src="/js/page/auth.js?v=20261001-7"></script>
    <script type="module" src="/js/common/login-draft.js?v=20261004-1"></script>
    <script defer src="/js/common/auth-sync.js?v=20261004-2"></script>
</body>
</html>
