<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#173e37">
    {{#if authenticated}}<meta name="bf-access-token" content="{{bfAccessToken}}">{{/if}}<script src="/js/common/bearer-fetch.js?v=20261006-1"></script>
    {{#if description}}<meta name="description" content="{{description}}">{{/if}}
    <title>{{#if title}}{{title}} | {{/if}}{{app.name}}</title>
    <link rel="icon" href="{{app.logoUrl}}">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/components/tables.css">
    <link rel="stylesheet" href="/css/components/forms.css?v=20261001-2">
    <link rel="stylesheet" href="/css/components/navigation.css?v=20261009-responsive-brand-1">
    <link rel="stylesheet" href="/css/theme.css?v=20261009-responsive-brand-1">
    <link rel="stylesheet" href="/css/pages/public.css?v=20261009-responsive-brand-1">
    {{#each stylesheets}}
        <link rel="stylesheet" href="{{this}}">
    {{/each}}
</head>
<body class="bf-layout bf-layout-public {{bodyClass}}" data-bf-theme="default" data-bf-app-name="{{app.name}}" data-bf-app-logo="{{app.logoUrl}}">
    {{> navigation/header
        publicNav=true
        brandName=app.name
        brandHref="/"
        profileHref="/customer/ho-so"
        links=navigation.headerLinks
        user=user
        accountLinks=navigation.accountLinks
        notifications=navigation.notifications
        unreadCount=navigation.unreadCount
        showNotifications=navigation.showNotifications
        sidebarId="main-sidebar"
    }}
    {{#if breadcrumbs}}
        <div class="bf-layout-container">
            {{> navigation/breadcrumb
                items=breadcrumbs
            }}
        </div>
    {{/if}}
    <main id="main-content" class="bf-layout-content bf-demo-main {{contentClass}}">
        {{{body}}}
    </main>
    <footer class="bf-demo-footer">
        <a class="bf-nav-brand bf-demo-brand" href="/">
            <img class="bf-nav-brand-logo" src="{{app.logoUrl}}" alt="">
            <span class="bf-nav-brand-name" title="{{app.name}}">{{app.name}}</span>
        </a>
        <span class="bf-demo-footer-summary">{{app.name}} · Bán sách · Mượn miễn phí · Thuê có phí · Hội viên</span>
    </footer>
    <script type="module" src="/js/components/forms.js?v=20261009-1"></script>
    <script type="module" src="/js/page/auth.js?v=20261001-5"></script>
    {{#if authenticated}}<script defer src="/js/common/session-keepalive.js?v=20261004-1"></script>{{/if}}
    <script type="module">import { initNavigation } from "/js/components/navigation.js"; initNavigation();</script>
    {{#each scripts}}
        <script type="module" src="{{this}}"></script>
    {{/each}}
    <script defer src="/js/common/auth-sync.js?v=20261004-2"></script>
</body>
</html>
