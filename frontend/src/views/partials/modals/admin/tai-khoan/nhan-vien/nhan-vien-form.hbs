{{#> modals/base-modal
    id="employee-create-modal"
    title="Thêm mới nhân viên"
    description="Nhập thông tin nhân viên mới."
    size="xl"
    className="bf-modal-sticky-footer"
    closeOnBackdrop=false
    loading=false
}}
    <form id="employee-create-form" class="bf-modal-form bf-modal-form-grid" data-employee-form novalidate>
        <div class="bf-form-grid-full">
            <h3 class="bf-employee-section-title">Thông tin tài khoản</h3>
        </div>
        {{> forms/input
            id="employee-name"
            name="hoTen"
            type="text"
            label="Họ và tên"
            placeholder="Nhập họ và tên"
            required=true
            maxlength=200
            icon="user"
        }}
        {{> forms/input
            id="employee-code"
            name="maNhanVien"
            type="text"
            label="Mã nhân viên"
            placeholder="Nhập mã nhân viên"
            required=true
            minlength=2
            maxlength=40
            icon="building"
        }}
        {{> forms/input
            id="employee-username"
            name="tenDangNhap"
            type="text"
            label="Tên đăng nhập"
            placeholder="Nhập tên đăng nhập"
            required=true
            minlength=3
            maxlength=40
            icon="user"
        }}
        {{> forms/email
            id="employee-email"
            name="email"
            label="Email"
            placeholder="Nhập email"
            required=true
            maxlength=254
            icon="email"
        }}
        {{> forms/phone
            id="employee-phone"
            name="soDienThoai"
            label="Số điện thoại"
            placeholder="Nhập số điện thoại"
        }}
        {{> forms/select
            id="employee-account-type"
            name="loaiTaiKhoan"
            label="Loại tài khoản"
            placeholder="Chọn loại tài khoản"
            required=true
            options=accountTypeOptions
            icon="shield"
        }}
        {{> forms/select
            id="employee-branch"
            name="chiNhanhId"
            label="Chi nhánh"
            placeholder="Chọn chi nhánh"
            required=true
            options=branchOptions
            search=true
            icon="store"
        }}
        <div class="bf-form-grid-full">
            <h3 class="bf-employee-section-title">Thông tin công việc</h3>
        </div>
        {{> forms/input
            id="employee-job-title"
            name="chucDanh"
            type="text"
            label="Chức danh"
            placeholder="Nhập chức danh"
            maxlength=120
        }}
        {{> forms/email
            id="employee-work-email"
            name="emailCongViec"
            label="Email công việc"
            placeholder="Nhập email công việc"
            maxlength=254
        }}
        {{> forms/phone
            id="employee-work-phone"
            name="soDienThoaiCongViec"
            label="Điện thoại công việc"
            placeholder="Nhập số điện thoại công việc"
        }}
        {{> forms/date
            id="employee-hire-date"
            name="ngayVaoLam"
            label="Ngày vào làm"
            placeholder="Ngày vào làm"
        }}
        {{> forms/date
            id="employee-leave-date"
            name="ngayNghiViec"
            label="Ngày nghỉ việc"
            placeholder="Ngày nghỉ việc"
            readonly=true
            disabled=true
        }}
        <div class="bf-form-field" data-employee-work-days-field>
            <label class="bf-form-label" for="employee-work-days">Số ngày làm việc</label>
            <input id="employee-work-days" class="bf-form-control" type="text" value="" readonly data-employee-work-days disabled>
        </div>
        <div class="bf-form-grid-full">
            <h3 class="bf-employee-section-title">Thông tin cá nhân</h3>
        </div>
        {{> forms/date
            id="employee-birthday"
            name="ngaySinh"
            label="Ngày sinh"
            placeholder="Ngày sinh"
        }}
        {{> forms/select
            id="employee-gender"
            name="gioiTinh"
            label="Giới tính"
            placeholder="Chọn giới tính"
            options=genderOptions
            icon="user"
        }}
        {{> forms/select
            id="employee-nationality"
            name="quocTich"
            label="Quốc tịch"
            placeholder="Chọn quốc tịch"
            options=countryOptions
            search=true
            icon="globe"
        }}
        {{> forms/select
            id="employee-ethnicity"
            name="danToc"
            label="Dân tộc"
            placeholder="Chọn dân tộc"
            options=ethnicityOptions
            search=true
            icon="users"
        }}
        {{> forms/select
            id="employee-country"
            name="quocGia"
            label="Quốc gia"
            placeholder="Chọn quốc gia"
            options=countryOptions
            search=true
            icon="globe"
        }}
        {{> forms/select
            id="employee-province"
            name="tinhThanh"
            label="Tỉnh/thành"
            placeholder="Chọn tỉnh/thành"
            options=provinceOptions
            search=true
            icon="map-pin"
        }}
        {{> forms/select
            id="employee-ward"
            name="xaPhuong"
            label="Xã/phường"
            placeholder="Chọn xã/phường"
            options=wardOptions
            search=true
            icon="map"
        }}
        {{> forms/textarea
            id="employee-address"
            className="bf-form-grid-full"
            name="diaChi"
            label="Địa chỉ"
            placeholder="Nhập địa chỉ chi tiết"
            maxlength=300
            rows=3
            icon="map-marked"
        }}
        {{> forms/textarea
            id="employee-description"
            className="bf-form-grid-full"
            name="moTa"
            label="Mô tả"
            placeholder="Nhập mô tả"
            maxlength=2000
            rows=3
            icon="file"
        }}
        <div class="bf-form-grid-full">
            <h3 class="bf-employee-section-title">CCCD/CMND</h3>
        </div>
        {{> forms/input
            id="employee-national-id"
            name="cccdSo"
            type="text"
            label="Số CCCD/CMND"
            placeholder="Nhập số CCCD/CMND"
            maxlength=30
        }}
        {{> forms/date
            id="employee-national-id-date"
            name="cccdNgayCap"
            label="Ngày cấp"
            placeholder="Ngày cấp"
        }}
        {{> forms/input
            id="employee-national-id-place"
            name="cccdNoiCap"
            type="text"
            label="Nơi cấp"
            placeholder="Nhập nơi cấp"
            maxlength=200
        }}
        <div class="bf-form-grid-full">
            <h3 class="bf-employee-section-title">Người liên hệ khẩn cấp</h3>
        </div>
        {{> forms/input
            id="employee-emergency-name"
            name="lienHeKhanCapHoTen"
            type="text"
            label="Họ tên"
            placeholder="Nhập họ tên"
            maxlength=200
        }}
        {{> forms/input
            id="employee-emergency-relationship"
            name="lienHeKhanCapQuanHe"
            type="text"
            label="Quan hệ"
            placeholder="Nhập quan hệ"
            maxlength=100
        }}
        {{> forms/phone
            id="employee-emergency-phone"
            name="lienHeKhanCapSoDienThoai"
            label="Số điện thoại"
            placeholder="Nhập số điện thoại"
        }}
        {{> forms/input
            id="employee-emergency-address"
            name="lienHeKhanCapDiaChi"
            type="text"
            label="Địa chỉ"
            placeholder="Nhập địa chỉ"
            maxlength=500
        }}
        <div class="bf-form-grid-full">
            <h3 class="bf-employee-section-title">Trình độ và chuyên môn</h3>
        </div>
        {{> forms/input
            id="employee-education"
            name="trinhDoHocVan"
            type="text"
            label="Trình độ học vấn"
            placeholder="Nhập trình độ học vấn"
            maxlength=200
        }}
        {{> forms/input
            id="employee-major"
            name="chuyenNganh"
            type="text"
            label="Chuyên ngành"
            placeholder="Nhập chuyên ngành"
            maxlength=200
        }}
        {{> forms/input
            id="employee-school"
            name="truong"
            type="text"
            label="Trường"
            placeholder="Nhập tên trường"
            maxlength=200
        }}
        {{> forms/input
            id="employee-certificates"
            name="chungChi"
            label="Chứng chỉ"
            placeholder="Nhập chứng chỉ"
            maxlength=5000
            rows=2
        }}
        {{> forms/textarea
            id="employee-languages"
            name="ngoaiNgu"
            label="Ngoại ngữ"
            placeholder="Nhập ngoại ngữ"
            maxlength=3000
            rows=2
        }}
        {{> forms/textarea
            id="employee-skills"
            name="kyNang"
            label="Kỹ năng"
            placeholder="Nhập kỹ năng"
            maxlength=5000
            rows=2
        }}
        <div class="bf-form-options bf-form-grid-full">
            {{> forms/checkbox
                id="employee-active"
                name="active"
                label="Hoạt động"
                checked=true
            }}
        </div>
    </form>
    <footer class="bf-modal-footer">
        <div class="bf-modal-footer-actions">
            <button type="button" class="bf-btn bf-btn-secondary bf-btn-md" data-bf-modal-close>Hủy</button>
            <button type="submit" form="employee-create-form" class="bf-btn bf-btn-primary bf-btn-md" data-bf-modal-submit>Thêm mới</button>
        </div>
    </footer>
{{/modals/base-modal}}