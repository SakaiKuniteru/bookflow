{{#> modals/base-modal id="employee-view-modal" title="Thông tin nhân viên" description="Thông tin tài khoản, vai trò và phân công." size="md" closeOnBackdrop=true}}
    <div class="bf-modal-form bf-modal-form-grid" data-employee-view-details></div>
    <footer class="bf-modal-footer">
        <div class="bf-modal-footer-actions">
            <button type="button" class="bf-btn bf-btn-secondary bf-btn-md" data-bf-modal-close>Đóng</button>
        </div>
    </footer>
{{/modals/base-modal}}
{{#> modals/base-modal id="employee-delete-modal" title="Cho nhân viên nghỉ" description="Nhân viên được chuyển sang danh sách đã nghỉ; dữ liệu lịch sử vẫn được giữ." size="sm" closeOnBackdrop=false}}
    <form id="employee-delete-form" class="bf-modal-form" data-employee-delete-form novalidate>
        <p class="bf-form-help" data-employee-delete-message></p>
        {{> forms/textarea id="employee-delete-reason" name="lyDo" label="Lý do nghỉ việc" placeholder="Nhập lý do nghỉ việc" required=true maxlength=1000 rows=3}}
    </form>
    <footer class="bf-modal-footer">
        <button type="button" class="bf-btn bf-btn-secondary bf-btn-md" data-bf-modal-close>Hủy</button>
        <div class="bf-modal-footer-actions">
            <button type="submit" form="employee-delete-form" class="bf-btn bf-btn-danger bf-btn-md" data-bf-modal-submit>Cho nghỉ</button>
        </div>
    </footer>
{{/modals/base-modal}}
{{#> modals/base-modal id="employee-rehire-modal" title="Cho nhân viên quay lại làm" description="Chọn chi nhánh làm việc để khôi phục tài khoản nhân viên." size="md" closeOnBackdrop=false}}
    <form id="employee-rehire-form" class="bf-modal-form" novalidate>
        <div class="bf-modal-confirm">
            <span class="bf-modal-confirm-icon">{{> ui/icon name="user" size=24}}</span>
            <div>
                <p class="bf-modal-confirm-message" data-employee-rehire-message></p>
                <p class="bf-modal-confirm-detail">Hệ thống sẽ gửi mật khẩu tạm mới tới email nhân viên. Khi đăng nhập, nhân viên cần tạo mật khẩu mới.</p>
            </div>
        </div>
        {{> forms/select id="employee-rehire-branch" name="chiNhanhId" label="Chi nhánh làm việc" placeholder="Chọn chi nhánh" required=true search=true icon="store"}}
    </form>
    <footer class="bf-modal-footer">
        <button type="button" class="bf-btn bf-btn-secondary bf-btn-md" data-bf-modal-close>Hủy</button>
        <div class="bf-modal-footer-actions"><button type="submit" form="employee-rehire-form" class="bf-btn bf-btn-primary bf-btn-md" data-bf-modal-submit>Quay lại làm</button></div>
    </footer>
{{/modals/base-modal}}
{{#> modals/base-modal id="employee-reset-password-modal" title="Cấp lại mật khẩu" description="Nhân viên sẽ nhận mật khẩu tạm qua email và cần đổi mật khẩu sau khi đăng nhập." size="sm" closeOnBackdrop=false}}
    <div class="bf-modal-confirm">
        <span class="bf-modal-confirm-icon">{{> ui/icon name="shield" size=24}}</span>
        <div>
            <p class="bf-modal-confirm-message" data-employee-reset-password-message></p>
            <p class="bf-modal-confirm-detail">Mật khẩu tạm có hiệu lực trong 24 giờ.</p>
        </div>
    </div>
    <footer class="bf-modal-footer">
        <button type="button" class="bf-btn bf-btn-secondary bf-btn-md" data-bf-modal-close>Hủy</button>
        <div class="bf-modal-footer-actions"><button type="button" class="bf-btn bf-btn-primary bf-btn-md" data-bf-modal-confirm data-action="reset-password" data-loading-on-confirm="true">Gửi mật khẩu mới</button></div>
    </footer>
{{/modals/base-modal}}