{{#> modals/base-modal
    id="customer-form-modal"
    title="Thêm mới khách hàng"
    description="Nhập thông tin khách hàng mới."
    size="xl"
    className="bf-modal-sticky-footer"
    closeOnBackdrop=false
    loading=false
}}
    <form id="customer-form" class="bf-modal-form bf-modal-form-grid" data-customer-form novalidate>
        <p class="bf-form-error bf-form-grid-full" data-customer-form-error role="alert" hidden></p>
        {{> forms/input id="customer-code" name="ma_khach_hang" type="text" label="Mã khách hàng" placeholder="Nhập mã khách hàng" required=true maxlength=40 icon="user"}}
        {{> forms/input id="customer-name" name="ho_ten" type="text" label="Họ và tên" placeholder="Nhập họ và tên" required=true maxlength=200 icon="user"}}
        {{> forms/select id="customer-type" name="loai_khach_hang" label="Loại khách hàng" placeholder="Chọn loại khách hàng" required=true options=customerTypeOptions icon="grid"}}
        <div class="bf-form-grid-full" data-customer-organization-field hidden>
            <div class="bf-modal-form-grid">
                {{> forms/input id="customer-organization" name="ten_to_chuc" type="text" label="Tên tổ chức" placeholder="Nhập tên tổ chức" maxlength=255 icon="building"}}
                {{> forms/input id="customer-tax-code" name="ma_so_thue" type="text" label="Mã số thuế" placeholder="Nhập mã số thuế" maxlength=30 icon="file"}}
            </div>
        </div>
        {{> forms/email id="customer-email" name="email" label="Email" placeholder="Nhập email" icon="email"}}
        {{> forms/input id="customer-phone" name="so_dien_thoai" type="tel" label="Số điện thoại" placeholder="Nhập số điện thoại" maxlength=30 icon="phone"}}
        {{> forms/select id="customer-gender" name="gioi_tinh" label="Giới tính" placeholder="Chọn giới tính" options=genderOptions icon="user"}}
        {{> forms/input id="customer-source" name="nguon_khach_hang" type="text" label="Nguồn khách hàng" placeholder="Nhập nguồn khách hàng" maxlength=50 icon="info"}}
        {{> forms/textarea id="customer-note" className="bf-form-grid-full" name="ghi_chu" label="Ghi chú" placeholder="Nhập ghi chú" maxlength=20000 rows=3 icon="file"}}
    </form>
    <footer class="bf-modal-footer">
        <button type="button" class="bf-btn bf-btn-secondary bf-btn-md" data-bf-modal-close>Hủy</button>
        <div class="bf-modal-footer-actions">
            <button type="submit" form="customer-form" class="bf-btn bf-btn-primary bf-btn-md" data-bf-modal-submit>Thêm mới</button>
        </div>
    </footer>
{{/modals/base-modal}}
