{{#> modals/base-modal
    id="catalog-form-modal"
    title="Thêm mới hội viên"
    description="Nhập thông tin hội viên."
    size="xl"
    className="bf-modal-sticky-footer"
    closeOnBackdrop=false
    loading=false
}}
    <form id="catalog-form" class="bf-modal-form bf-modal-form-grid" data-catalog-form novalidate>
        <p class="bf-form-help bf-form-grid-full" data-catalog-form-notice role="status" hidden></p>
        {{> forms/select
            id="catalog-khach-hang-id"
            name="khachHangId"
            label="Khách hàng"
            placeholder="Nhập khách hàng"
            required=true
            search=true
            optionsEndpoint="/api/khach-hang"
            optionsRowsKey="khachHang"
            optionsValueKey="id"
            optionsLabelKey="hoTen"
            optionsSecondaryKey="maKhachHang"
            readonlyOnEdit=true
            icon="user"
        }}
        {{> forms/select
            id="catalog-hang-hoi-vien-id"
            name="hangHoiVienId"
            label="Hạng hội viên"
            placeholder="Nhập hạng hội viên"
            required=true
            search=true
            optionsEndpoint="/api/hoi-vien/hang"
            optionsRowsKey="hangHoiVien"
            optionsValueKey="id"
            optionsLabelKey="tenHang"
            optionsSecondaryKey="maHang"
            readonlyOnEdit=true
            icon="shield"
        }}
        {{> forms/input
            id="catalog-ma-hoi-vien"
            name="maHoiVien"
            type="text"
            label="Mã hội viên"
            placeholder="Nhập mã hội viên"
            required=true
            maxlength="40"
            icon="edit"
        }}
        {{> forms/date
            id="catalog-ngay-het-han"
            name="ngayHetHan"
            label="Ngày hết hạn"
            placeholder="Nhập ngày hết hạn"
            icon="calendar"
        }}
        {{> forms/catalog-active}}
    </form>
    <footer class="bf-modal-footer">
        <button type="button" class="bf-btn bf-btn-secondary bf-btn-md" data-bf-modal-close>Hủy</button>
        <div class="bf-modal-footer-actions">
            <button type="submit" form="catalog-form" class="bf-btn bf-btn-primary bf-btn-md" data-bf-modal-submit>Thêm mới</button>
        </div>
    </footer>
{{/modals/base-modal}}
