{{#> modals/base-modal
    id="catalog-form-modal"
    title="Thêm mới nhà sản xuất"
    description="Nhập thông tin nhà sản xuất."
    size="xl"
    className="bf-modal-sticky-footer"
    closeOnBackdrop=false
    loading=false
}}
    <form id="catalog-form" class="bf-modal-form bf-modal-form-grid" data-catalog-form novalidate>
        <p class="bf-form-error bf-modal-form-error bf-form-grid-full" data-catalog-form-error role="alert" hidden></p>
        <p class="bf-form-help bf-form-grid-full" data-catalog-form-notice role="status" hidden></p>
        {{#each formFields}}
            {{#if (eq type "textarea")}}
                {{> forms/textarea id=id name=name label=label placeholder=placeholder required=required maxlength=maxlength rows=rows className=className}}
            {{else if (eq type "select")}}
                {{> forms/select id=id name=name label=label placeholder=label required=required options=options search=true}}
            {{else}}
                {{> forms/input id=id name=name type=type label=label placeholder=placeholder required=required maxlength=maxlength minlength=minlength className=className}}
            {{/if}}
        {{/each}}
    </form>
    <footer class="bf-modal-footer">
        <button type="button" class="bf-btn bf-btn-secondary bf-btn-md" data-bf-modal-close>Hủy</button>
        <div class="bf-modal-footer-actions">
            <button type="submit" form="catalog-form" class="bf-btn bf-btn-primary bf-btn-md" data-bf-modal-submit>Thêm mới</button>
        </div>
    </footer>
{{/modals/base-modal}}
