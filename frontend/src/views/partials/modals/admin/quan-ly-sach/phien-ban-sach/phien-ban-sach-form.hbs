{{#> modals/base-modal
    id="catalog-form-modal"
    title="Thêm mới phiên bản sách"
    description="Nhập thông tin phiên bản sách."
    size="xl"
    className="bf-modal-sticky-footer"
    closeOnBackdrop=false
    loading=false
}}
    <form id="catalog-form" class="bf-modal-form bf-modal-form-grid" data-catalog-form novalidate>
        <p class="bf-form-help bf-form-grid-full" data-catalog-form-notice role="status" hidden></p>
        {{> forms/select
            id="catalog-dau-sach-id"
            name="dauSachId"
            label="Đầu sách"
            placeholder="Nhập đầu sách"
            required=true
            search=true
            optionsEndpoint="/api/sach"
            optionsRowsKey="sach"
            optionsValueKey="id"
            optionsLabelKey="tenSach"
            icon="book"
        }}
        {{> forms/input
            id="catalog-ma-phien-ban"
            name="maPhienBan"
            type="text"
            label="Mã phiên bản"
            placeholder="Nhập mã phiên bản"
            required=true
            maxlength="60"
            icon="edit"
        }}
        {{> forms/input
            id="catalog-ten-phien-ban"
            name="tenPhienBan"
            type="text"
            label="Tên phiên bản"
            placeholder="Nhập tên phiên bản"
            maxlength="300"
            icon="edit"
        }}
        {{> forms/input
            id="catalog-ten-hien-thi"
            name="tenHienThi"
            type="text"
            label="Tên hiển thị"
            placeholder="Nhập tên hiển thị"
            maxlength="350"
            icon="edit"
        }}
        {{> forms/select
            id="catalog-loai-phien-ban"
            name="loaiPhienBan"
            label="Loại phiên bản"
            placeholder="Nhập loại phiên bản"
            search=true
            options=(lookup formOptions "loaiPhienBan")
            icon="grid"
            required=true
        }}
        {{> forms/select
            id="catalog-loai-bia"
            name="loaiBia"
            label="Loại bìa"
            placeholder="Nhập loại bìa"
            search=true
            options=(lookup formOptions "loaiBia")
            icon="grid"
            required=true
        }}
        {{> forms/select
            id="catalog-nha-xuat-ban-id"
            name="nhaXuatBanId"
            label="Nhà xuất bản"
            placeholder="Nhập nhà xuất bản"
            search=true
            optionsEndpoint="/api/nha-xuat-ban"
            optionsRowsKey="nhaXuatBan"
            optionsValueKey="id"
            optionsLabelKey="tenNhaXuatBan"
            icon="building"
            required=true
        }}
        {{> forms/input
            id="catalog-ma-san-pham-nha-xuat-ban"
            name="maSanPhamNhaXuatBan"
            type="text"
            label="Mã sản phẩm nhà xuất bản"
            placeholder="Nhập mã sản phẩm nhà xuất bản"
            maxlength="80"
            icon="edit"
        }}
        {{> forms/input
            id="catalog-ngon-ngu-chinh"
            name="ngonNguChinh"
            type="text"
            label="Ngôn ngữ chính"
            placeholder="Nhập ngôn ngữ chính"
            maxlength="15"
            icon="edit"
            required=true
        }}
        {{> forms/input
            id="catalog-ngon-ngu-goc"
            name="ngonNguGoc"
            type="text"
            label="Ngôn ngữ gốc"
            placeholder="Nhập ngôn ngữ gốc"
            maxlength="15"
            icon="edit"
            required=true
        }}
        {{> forms/date
            id="catalog-ngay-xuat-ban"
            name="ngayXuatBan"
            label="Ngày xuất bản"
            placeholder="Nhập ngày xuất bản"
            icon="calendar"
            required=true
        }}
        {{> forms/date
            id="catalog-nam-xuat-ban"
            name="namXuatBan"
            label="Năm xuất bản"
            placeholder="Nhập năm xuất bản"
            type="year"
            yearFrom="catalog-ngay-xuat-ban"
            icon="calendar"
            required=true
        }}
        {{> forms/number
            id="catalog-so-trang"
            name="soTrang"
            label="Số trang"
            placeholder="Nhập số trang"
            type="integer"
            min="1"
            icon="info"
            required=true
        }}
        {{> forms/number
            id="catalog-trong-luong-gram"
            name="trongLuongGram"
            label="Trọng lượng (g)"
            placeholder="Nhập trọng lượng (g)"
            decimals="2"
            min="0"
            icon="info"
        }}
        {{> forms/number
            id="catalog-gia-bia"
            name="giaBia"
            label="Giá bìa"
            placeholder="Nhập giá bìa"
            decimals="2"
            min="0"
            icon="info"
        }}
        {{> forms/input
            id="catalog-don-vi-tien-te"
            name="donViTienTe"
            type="text"
            label="Đơn vị tiền tệ"
            placeholder="Nhập đơn vị tiền tệ"
            maxlength="3"
            icon="edit"
        }}
        {{> forms/textarea
            id="catalog-mo-ta-rieng-phien-ban"
            name="moTaRiengPhienBan"
            label="Mô tả riêng phiên bản"
            placeholder="Nhập mô tả riêng phiên bản"
            rows="3"
            maxlength="30000"
            className="bf-form-grid-full"
            icon="edit"
        }}
        {{> forms/textarea
            id="catalog-ghi-chu-phien-ban"
            name="ghiChuPhienBan"
            label="Ghi chú phiên bản"
            placeholder="Nhập ghi chú phiên bản"
            rows="3"
            maxlength="20000"
            className="bf-form-grid-full"
            icon="edit"
        }}
        {{> forms/catalog-active}}
    </form>
    <footer class="bf-modal-footer">
        <button type="button" class="bf-btn bf-btn-secondary bf-btn-md" data-bf-modal-close>Hủy</button>
        <div class="bf-modal-footer-actions">
            <button type="submit" form="catalog-form" class="bf-btn bf-btn-primary bf-btn-md" data-bf-modal-submit>Thêm mới</button>
        </div>
    </footer>
{{/modals/base-modal}}
