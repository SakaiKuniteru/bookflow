{{#> modals/base-modal
    id="catalog-form-modal"
    title="Thêm mới tác giả"
    description="Nhập thông tin tác giả và ảnh đại diện."
    size="xl"
    className="bf-modal-sticky-footer bf-author-modal"
    closeOnBackdrop=false
    loading=false
}}
    <form id="catalog-form" class="bf-modal-form bf-modal-form-grid" data-catalog-form novalidate>
        <p class="bf-form-error bf-modal-form-error bf-form-grid-full" data-catalog-form-error role="alert" hidden></p>
        <p class="bf-form-help bf-form-grid-full" data-catalog-form-notice role="status" hidden></p>
        <div class="bf-profile-image-layout bf-form-grid-full bf-author-profile-layout">
            {{> forms/image
                id="author-photo"
                name="authorPhoto"
                label="Ảnh tác giả"
                imageTarget="anhDaiDienTepId"
                uploadType="ANH_TAC_GIA"
                width=176
                height=176
            }}
            <div class="bf-profile-image-fields">
                {{> forms/input
                    id="author-code"
                    name="maTacGia"
                    type="text"
                    label="Mã tác giả"
                    placeholder="Ví dụ: TG_NGUYEN_DU"
                    required=true
                    maxlength=50
                    icon="edit"
                }}
                {{> forms/input
                    id="author-name"
                    name="hoTen"
                    type="text"
                    label="Họ và tên"
                    placeholder="Nhập họ và tên tác giả"
                    required=true
                    maxlength=200
                    icon="user"
                }}
                {{> forms/input
                    id="author-display-name"
                    name="tenHienThi"
                    type="text"
                    label="Tên hiển thị"
                    placeholder="Để trống để dùng họ và tên"
                    maxlength=200
                    icon="user"
                }}
            </div>
        </div>
        <div class="bf-form-grid-full">
            <h3 class="bf-author-section-title">Tên gọi</h3>
        </div>
        {{> forms/input
            id="author-original-name"
            name="tenGoc"
            type="text"
            label="Tên gốc"
            placeholder="Nhập tên gốc"
            maxlength=200
            icon="edit"
        }}
        {{> forms/input
            id="author-sort-name"
            name="tenSapXep"
            type="text"
            label="Tên sắp xếp"
            placeholder="Nhập tên sắp xếp"
            maxlength=200
            icon="edit"
        }}
        {{> forms/input
            id="author-other-name"
            name="tenKhac"
            type="text"
            label="Tên khác"
            placeholder="Nhập tên khác"
            maxlength=200
            icon="edit"
        }}
        <div class="bf-form-grid-full">
            <h3 class="bf-author-section-title">Thông tin cá nhân và địa chỉ</h3>
        </div>
        {{> forms/date
            id="author-birth-date"
            name="ngaySinh"
            label="Ngày sinh"
            placeholder="Chọn ngày sinh"
            maxDateFrom="author-death-date"
            maxDateOffsetDays="-1"
            rangeError="Ngày sinh phải trước ngày mất."
            icon="calendar"
        }}
        {{> forms/date
            id="author-birth-year"
            name="namSinh"
            label="Năm sinh"
            placeholder="Tự lấy theo ngày sinh"
            type="year"
            yearFrom="author-birth-date"
            icon="calendar"
        }}
        {{> forms/date
            id="author-death-date"
            name="ngayMat"
            label="Ngày mất"
            placeholder="Chọn ngày mất"
            minDateFrom="author-birth-date"
            minDateOffsetDays="1"
            rangeError="Ngày mất phải sau ngày sinh."
            icon="calendar"
        }}
        {{> forms/date
            id="author-death-year"
            name="namMat"
            label="Năm mất"
            placeholder="Tự lấy theo ngày mất"
            type="year"
            yearFrom="author-death-date"
            icon="calendar"
        }}
        {{> forms/select
            id="author-nationality"
            name="quocTich"
            label="Quốc tịch"
            placeholder="Chọn quốc tịch"
            search=true
            icon="globe"
            addressRole="country"
            addressGroup="author-nationality"
        }}
        {{> forms/select
            id="author-origin-country"
            name="quocGiaXuatThan"
            label="Quốc gia xuất thân"
            placeholder="Chọn quốc gia"
            search=true
            icon="globe"
            addressRole="country"
            addressGroup="author-origin"
        }}
        {{> forms/input
            id="author-language"
            name="ngonNguSangTac"
            type="text"
            label="Ngôn ngữ sáng tác"
            placeholder="Ví dụ: vi"
            maxlength=15
            icon="globe"
        }}
        {{> forms/textarea
            id="author-field"
            name="linhVucSangTac"
            label="Lĩnh vực sáng tác"
            placeholder="Nhập lĩnh vực sáng tác"
            maxlength=2000
            rows=2
            icon="book"
        }}
        <div class="bf-form-grid-full">
            <h3 class="bf-author-section-title">Thông tin và tiểu sử</h3>
        </div>
        {{> forms/input
            id="author-website"
            name="website"
            type="url"
            label="Website"
            placeholder="https://"
            maxlength=2000
            icon="globe"
        }}
        {{> forms/input
            id="author-reference-url"
            name="urlThamKhao"
            type="url"
            label="URL tham khảo"
            placeholder="https://"
            maxlength=2000
            icon="globe"
        }}
        {{> forms/input
            id="author-data-source"
            name="nguonDuLieu"
            type="text"
            label="Nguồn dữ liệu"
            placeholder="Nhập nguồn dữ liệu"
            maxlength=80
            icon="file"
        }}
        {{> forms/textarea
            id="author-short-bio"
            name="tieuSuNgan"
            label="Tiểu sử ngắn"
            placeholder="Nhập tiểu sử ngắn"
            maxlength=2000
            rows=3
            className="bf-form-grid-full"
            icon="edit"
        }}
        {{> forms/textarea
            id="author-full-bio"
            name="tieuSuDayDu"
            label="Tiểu sử đầy đủ"
            placeholder="Nhập tiểu sử đầy đủ"
            maxlength=30000
            rows=5
            className="bf-form-grid-full"
            icon="edit"
        }}
        {{> forms/textarea
            id="author-achievements"
            name="thanhTuu"
            label="Thành tựu"
            placeholder="Nhập thành tựu"
            maxlength=10000
            rows=4
            className="bf-form-grid-full"
            icon="check"
        }}
    </form>
    <footer class="bf-modal-footer">
        <button type="button" class="bf-btn bf-btn-secondary bf-btn-md" data-bf-modal-close>Hủy</button>
        <div class="bf-modal-footer-actions">
            <button type="submit" form="catalog-form" class="bf-btn bf-btn-primary bf-btn-md" data-bf-modal-submit>Thêm mới</button>
        </div>
    </footer>
{{/modals/base-modal}}
