<svg
    class="bf-icon bf-icon-{{name}} {{className}}"
    width="{{#if size}}{{size}}{{else}}20{{/if}}"
    height="{{#if size}}{{size}}{{else}}20{{/if}}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
>
    {{#if (eq name "search")}}
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m16 16 5 5"></path>
    {{else if (eq name "plus")}}
        <path d="M12 5v14M5 12h14"></path>
    {{else if (eq name "edit")}}
        <path d="M12 20h9"></path>
        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
    {{else if (eq name "trash")}}
        <path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"></path>
    {{else if (eq name "check")}}
        <path d="m5 12 4 4L19 6"></path>
    {{else if (eq name "close")}}
        <path d="m6 6 12 12M18 6 6 18"></path>
    {{else if (eq name "upload")}}
        <path d="M12 16V4m-5 5 5-5 5 5M5 20h14"></path>
    {{else if (eq name "download")}}
        <path d="M12 4v12m-5-5 5 5 5-5M5 20h14"></path>
    {{else if (eq name "calendar")}}
        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
        <path d="M16 3v4M8 3v4M3 10h18"></path>
    {{else if (eq name "phone")}}
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 2.8a2 2 0 0 1-.6 1.7L7.7 9.5a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 1.7-.6l2.8.5a2 2 0 0 1 1.7 2.8Z"></path>
    {{else if (eq name "email")}}
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
    {{else if (eq name "book")}}
        <path d="M12 6.5C10.2 4.8 7.4 4 3 4v15c4.4 0 7.2.8 9 2.5m0-15C13.8 4.8 16.6 4 21 4v15c-4.4 0-7.2.8-9 2.5m0-15v15"></path>
    {{else if (eq name "user")}}
        <circle cx="12" cy="8" r="4"></circle>
        <path d="M4 21a8 8 0 0 1 16 0"></path>
    {{else if (eq name "lock")}}
        <rect x="4" y="10" width="16" height="11" rx="2"></rect>
        <path d="M8 10V7a4 4 0 1 1 8 0v3m-4 5v2"></path>
    {{else if (eq name "chart")}}
        <path d="M4 20V11h4v9M10 20V5h4v15m2 0v-8h4v8M2 20h20"></path>
    {{else if (eq name "shield")}}
        <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"></path>
        <path d="m9 12 2 2 4-4"></path>
    {{else if (eq name "eye")}}
        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
        <circle cx="12" cy="12" r="3"></circle>
    {{else if (eq name "file")}}
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
        <path d="M14 2v6h6M8 13h8M8 17h8"></path>
    {{else if (eq name "info")}}
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 11v5m0-8h.01"></path>
    {{else if (eq name "warning")}}
        <path d="m10.3 3.9-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3.1l-8-14a2 2 0 0 0-3.4 0Z"></path>
        <path d="M12 9v4m0 4h.01"></path>
    {{else if (eq name "chevron-down")}}
        <path d="m6 9 6 6 6-6"></path>
    {{else if (eq name "menu")}}
        <path d="M4 6h16M4 12h16M4 18h16"></path>
    {{else if (eq name "cart")}}
        <path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 8H6"></path>
        <circle cx="10" cy="20" r="1"></circle>
        <circle cx="18" cy="20" r="1"></circle>
    {{else if (eq name "building")}}
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <path d="M9 21V7h6v14M7 7h2m6 0h2M7 11h2m6 0h2M7 15h2m6 0h2"></path>
    {{else if (eq name "grid")}}
        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
    {{else if (eq name "globe")}}
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>
    {{else if (eq name "map-pin")}}
        <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
    {{else if (eq name "map")}}
        <path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z"></path>
        <path d="M9 3v15m6-12v15"></path>
    {{else if (eq name "map-marked")}}
        <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
        <path d="M9 13v-3l3-2 3 2v3m-5 0v-2h4v2"></path>
    {{else if (eq name "crosshair")}}
        <circle cx="12" cy="12" r="8"></circle>
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
    {{else}}
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 11v5m0-8h.01"></path>
    {{/if}}
</svg>