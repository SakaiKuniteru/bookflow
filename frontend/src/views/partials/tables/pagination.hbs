<nav class="bf-table-pagination" aria-label="Phân trang">
    <label class="bf-table-page-size">
        <span>Số dòng</span>
        <select name="pageSize" data-table-page-size aria-label="Số dòng mỗi trang">
            <option value="10" {{#if (eq pagination.pageSize 10)}}selected{{/if}}>10</option>
            <option value="20" {{#if (or (eq pagination.pageSize 20) (not pagination.pageSize))}}selected{{/if}}>20</option>
            <option value="50" {{#if (eq pagination.pageSize 50)}}selected{{/if}}>50</option>
            <option value="100" {{#if (eq pagination.pageSize 100)}}selected{{/if}}>100</option>
        </select>
        <span>/ trang</span>
    </label>
    <div class="bf-table-page-controls">
        <button type="button" data-page-action="first" aria-label="Trang đầu">«</button>
        <button type="button" data-page-action="prev" aria-label="Trang trước">‹</button>
        <button type="button" class="bf-table-current-page" disabled aria-current="page"><span data-current-page>{{pagination.page}}</span></button>
        <span class="bf-table-visually-hidden">trên <span data-total-pages>{{pagination.pages}}</span> trang</span>
        <button type="button" data-page-action="next" aria-label="Trang sau">›</button>
        <button type="button" data-page-action="last" aria-label="Trang cuối">»</button>
    </div>
    <div class="bf-table-record-count">Hiển thị <span data-page-from>{{pagination.from}}</span>–<span data-page-to>{{pagination.to}}</span> / <span data-total-records>{{pagination.total}}</span></div>
</nav>