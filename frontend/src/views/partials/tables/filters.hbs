{{#if filters}}
    <div class="bf-table-filters">
        {{> tables/filter-fields filters=filters}}
        <div class="bf-table-filter-actions">
            <button type="submit" class="bf-btn bf-btn-primary bf-btn-sm">Áp dụng</button>
            <button type="reset" class="bf-btn bf-btn-secondary bf-btn-sm" data-table-reset>Làm mới</button>
        </div>
    </div>
{{/if}}
