{{#if filters}}
    <div class="bf-table-filters">
        <div class="bf-table-filter-list">
            {{#each filters}}
                <div class="bf-table-filter" data-bf-table-filter data-filter-name="{{name}}">
                    {{#if (eq type "select")}}
                        {{> forms/select
                            id=id
                            name=name
                            label=label
                            placeholder=placeholder
                            options=options
                            multiple=false
                            search=search
                        }}
                    {{else if (eq type "date")}}
                        {{> forms/date
                            id=id
                            name=name
                            label=label
                            value=value
                            type="date"
                            placeholder=placeholder
                        }}
                    {{else if (eq type "date-range")}}
                        <div class="bf-table-date-range">
                            {{> forms/date
                                id=fromId
                                name=fromName
                                label=labelFrom
                                value=fromValue
                                type="date"
                                placeholder=placeholderFrom
                            }}
                            {{> forms/date
                                id=toId
                                name=toName
                                label=labelTo
                                value=toValue
                                type="date"
                                placeholder=placeholderTo
                            }}
                        </div>
                    {{else if (eq type "checkbox")}}
                        <label class="bf-table-checkbox-filter">
                            <input
                                type="checkbox"
                                name="{{name}}"
                                value="{{#if value}}{{value}}{{else}}true{{/if}}"
                                {{#if checked}}checked{{/if}}
                            >
                            <span>{{label}}</span>
                        </label>
                    {{else}}
                        {{> forms/input
                            id=id
                            name=name
                            label=label
                            value=value
                            placeholder=placeholder
                            type="text"
                        }}
                    {{/if}}
                </div>
            {{/each}}
        </div>
        <div class="bf-table-filter-actions">
            <button type="submit" class="bf-btn bf-btn-primary bf-btn-sm">Áp dụng</button>
            <button type="reset" class="bf-btn bf-btn-secondary bf-btn-sm" data-table-reset>Làm mới</button>
        </div>
    </div>
{{/if}}

<div class="bf-table-toolbar">
    <div class="bf-table-toolbar-main">
        {{#if search}}
            <div class="bf-table-global-search">
                {{> forms/search
                    id=search.id
                    name=search.name
                    value=search.value
                    placeholder=search.placeholder
                    mode=search.mode
                    threshold=search.threshold
                }}
            </div>
        {{/if}}
        {{#if toolbarTitle}}<h2 class="bf-table-title">{{toolbarTitle}}</h2>{{/if}}
    </div>
    {{#if actions}}
        <div class="bf-table-actions">
            {{#each actions}}
                {{#if href}}
                    {{> ui/nut-bam
                        href=href
                        label=label
                        icon=icon
                        variant=variant
                        size=size
                        disabled=disabled
                        className=className
                    }}
                {{else}}
                    <button
                        type="{{#if type}}{{type}}{{else}}button{{/if}}"
                        class="bf-btn bf-btn-{{#if variant}}{{variant}}{{else}}secondary{{/if}} bf-btn-{{#if size}}{{size}}{{else}}md{{/if}} {{className}}"
                        data-table-action="{{action}}"
                        {{#if disabled}}disabled{{/if}}
                        title="{{title}}"
                    >
                        {{#if icon}}
                            {{> ui/icon
                                name=icon
                                size="18"
                            }}
                        {{/if}}
                        <span class="bf-btn-text">{{label}}</span>
                    </button>
                {{/if}}
            {{/each}}
        </div>
    {{/if}}
</div>