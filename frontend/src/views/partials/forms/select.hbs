<div class="bf-form-field {{className}}" data-form-field>
    {{#if label}}
        <label class="bf-form-label" for="{{id}}">
            {{label}}
            {{#if required}}<span class="bf-form-required">*</span>{{/if}}
        </label>
    {{/if}}
    <div
        id="{{id}}"
        class="bf-select"
        data-bf-select
        data-name="{{name}}"
        data-multiple="{{multiple}}"
        data-select-all="{{selectAll}}"
        data-search="{{search}}"
        data-checkbox="{{checkbox}}"
        data-placeholder="{{placeholder}}"
    >
        <div class="bf-select-control" role="combobox" tabindex="{{#if search}}-1{{else}}0{{/if}}" aria-haspopup="listbox" aria-expanded="false">
            <span class="bf-select-value"></span>
            {{#if search}}
                <input type="text" class="bf-select-search-input" placeholder="{{placeholder}}" autocomplete="off" aria-label="{{label}}" tabindex="0">
            {{/if}}
            <span class="bf-select-icons">
                <svg class="bf-select-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                <button type="button" class="bf-select-clear" aria-label="Xóa lựa chọn" hidden>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"></path></svg>
                </button>
            </span>
        </div>
        <div class="bf-select-menu">
            <div class="bf-select-options" role="listbox" aria-multiselectable="{{multiple}}">
                {{#each options}}
                    <button type="button" class="bf-select-option {{#if selected}}is-selected{{/if}}" data-value="{{value}}" data-label="{{label}}" role="option" aria-selected="{{#if selected}}true{{else}}false{{/if}}" {{#if disabled}}disabled{{/if}}>
                        {{#if ../checkbox}}<span class="bf-select-option-checkbox" aria-hidden="true"></span>{{/if}}
                        <span class="bf-select-option-label">{{label}}</span>
                        <span class="bf-select-check" aria-hidden="true">✓</span>
                    </button>
                {{/each}}
            </div>
            <div class="bf-select-empty" hidden>Không tìm thấy dữ liệu.</div>
        </div>
        <div class="bf-select-hidden-values"></div>
    </div>
    {{#if helpText}}<div class="bf-form-help">{{helpText}}</div>{{/if}}
    {{#if error}}<div class="bf-form-error">{{error}}</div>{{/if}}
</div>