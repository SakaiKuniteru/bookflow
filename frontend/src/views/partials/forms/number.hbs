<div class="bf-form-field {{className}}" data-form-field {{#if readonlyOnEdit}}data-readonly-on-edit="true"{{/if}}>
    {{#if label}}
        <label class="bf-form-label" for="{{id}}">{{label}}{{#if required}}<span class="bf-form-required">*</span>{{/if}}</label>
    {{/if}}
    {{#if icon}}<div class="bf-input-icon-wrap"><span class="bf-input-leading-icon">{{> ui/icon name=icon size=18}}</span>{{/if}}
    <input
        id="{{id}}"
        {{#if name}}name="{{name}}"{{/if}}
        type="text"
        inputmode="decimal"
        class="bf-form-control bf-number-input"
        value="{{value}}"
        placeholder="{{placeholder}}"
        data-number-type="{{#if type}}{{type}}{{else}}decimal{{/if}}"
        data-number-decimals="{{decimals}}"
        {{#if ariaLabel}}aria-label="{{ariaLabel}}"{{/if}}
        data-min="{{min}}"
        data-max="{{max}}"
        {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
        {{#if minlength}}minlength="{{minlength}}"{{/if}}
        {{#if required}}required{{/if}}
        {{#if disabled}}disabled{{/if}}
        {{#if readonly}}readonly{{/if}}
    >
    {{#if icon}}</div>{{/if}}
    {{#if helpText}}<div class="bf-form-help">{{helpText}}</div>{{/if}}
    {{#if error}}<div class="bf-form-error">{{error}}</div>{{/if}}
</div>
