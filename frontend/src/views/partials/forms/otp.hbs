<div class="bf-form-field bf-otp-field {{#if error}}is-invalid{{/if}}" data-bf-otp>
    <label class="bf-form-label" for="bf-otp-digit-1">
        {{#if label}}{{label}}{{else}}Mã xác nhận{{/if}}<span class="bf-form-required">*</span>
    </label>
    <div class="bf-otp-inputs" role="group" aria-label="Mã xác nhận gồm 6 chữ số">
        <div class="bf-form-field bf-otp-digit-field">
            <input id="bf-otp-digit-1" type="text" class="bf-form-control" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="one-time-code" aria-label="Chữ số 1 của mã xác nhận">
        </div>
        <div class="bf-form-field bf-otp-digit-field">
            <input id="bf-otp-digit-2" type="text" class="bf-form-control" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" aria-label="Chữ số 2 của mã xác nhận">
        </div>
        <div class="bf-form-field bf-otp-digit-field">
            <input id="bf-otp-digit-3" type="text" class="bf-form-control" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" aria-label="Chữ số 3 của mã xác nhận">
        </div>
        <div class="bf-form-field bf-otp-digit-field">
            <input id="bf-otp-digit-4" type="text" class="bf-form-control" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" aria-label="Chữ số 4 của mã xác nhận">
        </div>
        <div class="bf-form-field bf-otp-digit-field">
            <input id="bf-otp-digit-5" type="text" class="bf-form-control" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" aria-label="Chữ số 5 của mã xác nhận">
        </div>
        <div class="bf-form-field bf-otp-digit-field">
            <input id="bf-otp-digit-6" type="text" class="bf-form-control" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" aria-label="Chữ số 6 của mã xác nhận">
        </div>
    </div>
    <div class="bf-form-error bf-auth-otp-error" data-otp-error role="alert" {{#unless error}}hidden{{/unless}}>{{#if error}}{{error}}{{else}}Vui lòng nhập đầy đủ mã xác nhận gồm 6 chữ số.{{/if}}</div>
    <input type="hidden" name="{{#if name}}{{name}}{{else}}otp{{/if}}" value="" data-bf-otp-value>
</div>