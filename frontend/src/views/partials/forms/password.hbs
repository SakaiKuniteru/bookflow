<div class="bf-form-field {{className}}" data-form-field>
    {{#if label}}
        <label class="bf-form-label" for="{{id}}">
            {{label}}
            {{#if required}}<span class="bf-form-required">*</span>{{/if}}
        </label>
    {{/if}}
    <div class="bf-input-with-action {{#if icon}}has-leading-icon{{/if}}">
        {{#if icon}}
            <span class="bf-input-leading-icon">
                {{> ui/icon
                    name=icon
                    size=18
                }}
            </span>
        {{/if}}
        <input
            id="{{id}}"
            name="{{name}}"
            type="password"
            class="bf-form-control"
            value="{{value}}"
            placeholder="{{placeholder}}"
            autocomplete="{{autocomplete}}"
            {{#if required}}required{{/if}}
            {{#if minlength}}minlength="{{minlength}}"{{/if}}
            {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
            {{#if pattern}}pattern="{{pattern}}"{{/if}}
            {{#if disabled}}disabled{{/if}}
            {{#if readonly}}readonly{{/if}}
        >
        <button
            type="button"
            class="bf-input-action bf-password-toggle"
            aria-label="Hiển thị mật khẩu"
            aria-pressed="false"
        >
            <svg class="bf-password-icon-eye" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <svg class="bf-password-icon-eye-off" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m3 3 18 18"></path>
                <path d="M10.6 6.2A10.8 10.8 0 0 1 12 6c6.5 0 10 6 10 6a17 17 0 0 1-3.1 3.7"></path>
                <path d="M6.2 6.3C3.5 8.1 2 12 2 12s3.5 6 10 6c1.1 0 2.1-.2 3-.5"></path>
                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
            </svg>
        </button>
    </div>
    {{#if helpText}}<div class="bf-form-help">{{helpText}}</div>{{/if}}
</div>