<div class="bf-form-field {{className}}" data-form-field>
    {{#if label}}
        <label class="bf-form-label" for="{{id}}">{{label}}{{#if required}}<span class="bf-form-required">*</span>{{/if}}</label>
    {{/if}}
    <div class="bf-phone-control {{#if icon}}has-leading-icon{{/if}}" data-bf-phone data-phone-format="{{#if format}}{{format}}{{else}}local{{/if}}">
        {{#if icon}}<span class="bf-input-leading-icon">{{> ui/icon name=icon size=18}}</span>{{/if}}
        <input
            id="{{id}}"
            type="tel"
            inputmode="tel"
            class="bf-form-control bf-phone-input {{#if error}}is-invalid{{/if}}"
            value="{{value}}"
            placeholder="{{#if placeholder}}{{placeholder}}{{else}}0912 345 678{{/if}}"
            autocomplete="tel"
            {{#if required}}required{{/if}}
            {{#if disabled}}disabled{{/if}}
            {{#if readonly}}readonly{{/if}}
        >
        <input type="hidden" class="bf-phone-value" name="{{name}}" value="">
    </div>
    <div class="bf-form-error bf-phone-error" hidden>Số điện thoại Việt Nam phải gồm mã 0 và 9 chữ số.</div>
    {{#if helpText}}<div class="bf-form-help">{{helpText}}</div>{{/if}}
    {{#if error}}<div class="bf-form-error">{{error}}</div>{{/if}}
</div>
