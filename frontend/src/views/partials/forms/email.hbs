<div class="bf-form-field {{className}}" data-form-field>
    {{#if label}}
        <label class="bf-form-label" for="{{id}}">
            {{label}}
            {{#if required}}<span class="bf-form-required">*</span>{{/if}}
        </label>
    {{/if}}
    {{#if icon}}
        <div class="bf-input-icon-wrap">
            <span class="bf-input-leading-icon">
                {{> ui/icon 
                    name=icon 
                    size=18
                }}
            </span>
            {{/if}}
            <input
                id="{{id}}"
                name="{{name}}"
                type="email"
                class="bf-form-control bf-email-input {{#if error}}is-invalid{{/if}}"
                value="{{value}}"
                placeholder="{{placeholder}}"
                autocomplete="email"
                spellcheck="false"
                {{#if required}}required{{/if}}
                {{#if disabled}}disabled{{/if}}
                {{#if readonly}}readonly{{/if}}
            >
        {{#if icon}}
        </div>
    {{/if}}
    <div class="bf-form-error bf-email-error" {{#unless error}}hidden{{/unless}}>{{#if error}}{{error}}{{else}}Email không hợp lệ.{{/if}}</div>
    {{#if helpText}}<div class="bf-form-help">{{helpText}}</div>{{/if}}
</div>
