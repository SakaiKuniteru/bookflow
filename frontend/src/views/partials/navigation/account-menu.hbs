<div class="bf-nav-menu-wrap {{className}}" data-bf-menu>
    <button
        type="button"
        class="bf-nav-account-trigger"
        data-bf-menu-trigger
        aria-expanded="false"
        aria-haspopup="true"
    >
        {{#if user.avatar}}
            <img class="bf-nav-avatar" src="{{user.avatar}}" alt="">
        {{else}}
            <span class="bf-nav-avatar bf-nav-avatar-fallback">{{#if user.name}}{{user.name.[0]}}{{else}}{{#if user.taiKhoan.hoTen}}{{user.taiKhoan.hoTen.[0]}}{{else}}{{#if user.tai_khoan.ho_ten}}{{user.tai_khoan.ho_ten.[0]}}{{else}}?{{/if}}{{/if}}{{/if}}</span>
        {{/if}}
        <span class="bf-nav-account-name">{{#if user.name}}{{user.name}}{{else}}{{#if user.taiKhoan.hoTen}}{{user.taiKhoan.hoTen}}{{else}}{{#if user.tai_khoan.ho_ten}}{{user.tai_khoan.ho_ten}}{{else}}Tài khoản{{/if}}{{/if}}{{/if}}</span>
        {{> ui/icon
            name="chevron-down"
            size="16"
        }}
    </button>
    <div class="bf-nav-menu bf-nav-account-menu" data-bf-menu-panel hidden>
        <a class="bf-nav-account-summary" href="{{profileHref}}">
            {{#if user.avatar}}
                <img class="bf-nav-avatar" src="{{user.avatar}}" alt="">
            {{else}}
                <img class="bf-nav-avatar" data-bf-avatar-file-id="{{user.tai_khoan.anh_dai_dien_tep_id}}" alt="" hidden>
                <span class="bf-nav-avatar bf-nav-avatar-fallback" data-bf-avatar-fallback>{{#if user.name}}{{user.name.[0]}}{{else}}{{#if user.tai_khoan.ho_ten}}{{user.tai_khoan.ho_ten.[0]}}{{else}}{{#if user.taiKhoan.hoTen}}{{user.taiKhoan.hoTen.[0]}}{{else}}?{{/if}}{{/if}}{{/if}}</span>
            {{/if}}
            <span class="bf-nav-account-summary-details">
                <strong>{{#if user.name}}{{user.name}}{{else}}{{#if user.tai_khoan.ho_ten}}{{user.tai_khoan.ho_ten}}{{else}}{{#if user.taiKhoan.hoTen}}{{user.taiKhoan.hoTen}}{{else}}Tài khoản{{/if}}{{/if}}{{/if}}</strong>
                <span>{{#if user.email}}{{user.email}}{{else}}{{#if user.tai_khoan.email}}{{user.tai_khoan.email}}{{else}}{{user.taiKhoan.email}}{{/if}}{{/if}}</span>
            </span>
        </a>
        <form class="bf-nav-logout-form" method="post" action="/auth/dang-xuat">
            <button class="bf-nav-menu-item" type="submit">Đăng xuất</button>
        </form>
    </div>
</div>