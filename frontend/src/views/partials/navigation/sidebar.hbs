<aside id="{{id}}" class="bf-nav-sidebar {{className}}" data-bf-sidebar>
    <a class="bf-nav-sidebar-brand" href="{{dashboardHref}}" aria-label="{{app.name}} - Tổng quan">
        <img src="{{app.logoUrl}}" alt="">
        <span>{{app.name}}</span>
    </a>
    {{#if title}}<div class="bf-nav-sidebar-title">{{title}}</div>{{/if}}
    <nav class="bf-nav-sidebar-menu" aria-label="{{#if ariaLabel}}{{ariaLabel}}{{else}}Điều hướng{{/if}}">
        <ul class="bf-nav-sidebar-list">
            {{#each items}}
                {{#if divider}}<li class="bf-nav-sidebar-divider" role="presentation"></li>{{/if}}
                {{#if group}}<li class="bf-nav-sidebar-group">{{group}}</li>{{/if}}
                {{#if children}}
                    <li class="bf-nav-sidebar-item bf-nav-sidebar-parent {{#if active}}is-active{{/if}}">
                        <details class="bf-nav-sidebar-group-toggle" {{#if active}}open{{/if}}>
                            <summary class="bf-nav-sidebar-group">{{label}}</summary>
                            <ul class="bf-nav-sidebar-submenu">
                                {{#each children}}
                                    <li class="bf-nav-sidebar-item">{{> navigation/sidebar-link}}</li>
                                {{/each}}
                            </ul>
                        </details>
                    </li>
                {{else}}
                    <li class="bf-nav-sidebar-item">{{> navigation/sidebar-link}}</li>
                {{/if}}
            {{/each}}
        </ul>
    </nav>
    {{#if user}}
        <div class="bf-nav-sidebar-account">
            <a class="bf-nav-sidebar-account-info" href="{{profileHref}}">
                    <img class="bf-nav-avatar" src="{{user.avatar}}" data-bf-avatar-file-id="{{user.taiKhoan.anhDaiDienTepId}}" alt="" {{#unless user.avatar}}hidden{{/unless}}>
                    <span class="bf-nav-avatar bf-nav-avatar-fallback" data-bf-avatar-fallback data-bf-avatar-initial {{#if user.avatar}}hidden{{/if}}>{{#if user.name}}{{user.name.[0]}}{{else}}{{#if user.taiKhoan.hoTen}}{{user.taiKhoan.hoTen.[0]}}{{else}}A{{/if}}{{/if}}</span>
                <span class="bf-nav-sidebar-account-details">
                    <strong data-bf-account-name>{{#if user.taiKhoan.hoTen}}{{user.taiKhoan.hoTen}}{{else}}Tài khoản{{/if}}</strong>
                    <small data-bf-account-email>{{#if user.taiKhoan.email}}{{user.taiKhoan.email}}{{else}}{{user.email}}{{/if}}</small>
                </span>
            </a>
            <form class="bf-nav-logout-form" method="post" action="/auth/dang-xuat">
                <button class="bf-nav-sidebar-logout" type="submit">Đăng xuất</button>
            </form>
        </div>
    {{/if}}
</aside>
