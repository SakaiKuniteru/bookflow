<div class="bf-nav-menu-wrap {{className}}" data-bf-menu>
    <button type="button" class="bf-nav-notification-trigger" data-bf-menu-trigger aria-expanded="false" aria-haspopup="true" aria-label="Thông báo">
        {{> ui/icon name="bell" size="20"}}
        {{#if unreadCount}}<span class="bf-nav-notification-count">{{unreadCount}}</span>{{/if}}
    </button>
    <div class="bf-nav-menu bf-nav-notification-menu" data-bf-menu-panel hidden>
        <div class="bf-nav-menu-heading">
            <strong>{{#if title}}{{title}}{{else}}Thông báo{{/if}}</strong>
            {{#if unreadCount}}<button type="button" class="bf-nav-text-button" data-bf-menu-action="mark-all-read">Đánh dấu đã đọc</button>{{/if}}
        </div>
        <div class="bf-nav-notification-list">
            {{#if notifications}}
                {{#each notifications}}
                    <a class="bf-nav-notification {{#if read}}is-read{{else}}is-unread{{/if}}" href="{{#if href}}{{href}}{{else}}#{{/if}}" data-bf-notification data-notification-id="{{id}}">
                        <span class="bf-nav-notification-dot" aria-hidden="true"></span>
                        <span class="bf-nav-notification-content">
                            <strong>{{title}}</strong>
                            {{#if message}}<span>{{message}}</span>{{/if}}
                            {{#if time}}<small>{{time}}</small>{{/if}}
                        </span>
                    </a>
                {{/each}}
            {{else}}
                <div class="bf-nav-notification-empty">Bạn chưa có thông báo.</div>
            {{/if}}
        </div>
        {{#if allNotificationsHref}}<a class="bf-nav-menu-footer" href="{{allNotificationsHref}}">Xem tất cả thông báo</a>{{/if}}
    </div>
</div>