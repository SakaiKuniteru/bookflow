<footer class="bf-nav-footer {{className}}">
    <div class="bf-nav-footer-main">
        <div class="bf-nav-footer-brand">
            <img class="bf-nav-brand-logo" src="{{app.logoUrl}}" alt="">
            <strong class="bf-nav-footer-brand-name" title="{{#if brandName}}{{brandName}}{{else}}{{app.name}}{{/if}}">{{#if brandName}}{{brandName}}{{else}}{{app.name}}{{/if}}</strong>
            {{#if description}}<p>{{description}}</p>{{/if}}
        </div>
        {{#each groups}}
            <nav class="bf-nav-footer-group" aria-label="{{title}}">
                <h2>{{title}}</h2>
                {{#each links}}
                    <a href="{{href}}">{{label}}</a>
                {{/each}}
            </nav>
        {{/each}}
    </div>
    <div class="bf-nav-footer-bottom">
        <span>{{#if copyright}}{{copyright}}{{else}}© {{year}} {{#if brandName}}{{brandName}}{{else}}{{app.name}}{{/if}}{{/if}}</span>
        {{#if bottomLinks}}
            <nav aria-label="Liên kết cuối trang">
                {{#each bottomLinks}}<a href="{{href}}">{{label}}</a>{{/each}}
            </nav>
        {{/if}}
    </div>
</footer>
