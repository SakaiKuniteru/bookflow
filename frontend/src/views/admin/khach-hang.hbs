<section class="bf-customer-page">
    {{#> admin/page-shell title=title description="Danh sách khách hàng trong đơn vị của bạn." icon="user"}}
        {{> tables/data-table
            mode=mode
            action=action
            ariaLabel=ariaLabel
            minWidth=minWidth
            columns=columns
            rows=rows
            hasRows=hasRows
            loading=tableLoading
            search=search
            actions=actions
            sort=sort
            pagination=pagination
            emptyTitle=emptyTitle
            emptyDescription=emptyDescription
            emptyIllustration=true
        }}
