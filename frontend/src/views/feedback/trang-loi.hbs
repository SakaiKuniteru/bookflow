<section class="bf-public-page bf-demo-error-page">
    <p class="bf-public-eyebrow">BookFlow</p>
    <h1>{{#if title}}{{title}}{{else}}Đã xảy ra lỗi{{/if}}</h1>
    <p>{{#if message}}{{message}}{{else}}Không thể hoàn tất yêu cầu này. Vui lòng thử lại.{{/if}}</p>
    <div class="bf-demo-hero-buttons">
        <a class="bf-demo-button bf-demo-primary" href="/">Về trang chủ</a>
        <button class="bf-demo-button" type="button" onclick="window.location.reload()">Thử lại</button>
    </div>
    {{#if requestId}}<small>Mã yêu cầu: {{requestId}}</small>{{/if}}
</section>