<section class="bf-public-page bf-demo-customer-page"><header class="bf-demo-customer-heading"><div><p class="bf-public-eyebrow">Tủ sách cá nhân</p><h1>Mượn &amp; thuê sách</h1><p>Chọn sách để gửi yêu cầu; nhân viên sẽ xác nhận và bàn giao tại chi nhánh.</p></div><a class="bf-demo-button bf-demo-primary" href="/sach?loai=muon">＋&nbsp; Tìm sách để mượn</a></header>
    {{#if requests}}<div class="bf-demo-loan-list">{{#each requests}}<article class="bf-demo-loan-card"><span class="bf-demo-mini-cover">✦</span><div><strong>{{this.ten_sach}}</strong><small>{{this.ma_phieu_muon}} · {{this.hinh_thuc_hien_thi}} · Chi nhánh {{this.ten_chi_nhanh}}</small><small>Ngày yêu cầu: {{formatDate this.ngay_tao}} · Hẹn trả: {{formatDate this.han_tra}}</small></div><div class="bf-demo-loan-status"><span class="bf-demo-status">{{#if this.trang_thai_hien_thi}}{{this.trang_thai_hien_thi}}{{else}}Đang mượn{{/if}}</span><small>{{#if this.phi_hien_thi}}{{this.phi_hien_thi}}{{else}}Mượn miễn phí{{/if}}</small></div></article>{{/each}}</div>{{else}}<div class="bf-demo-empty"><span>▤</span><h2>Bạn chưa có yêu cầu mượn</h2><p>Sách mượn và thuê của bạn sẽ được theo dõi tại đây.</p><a class="bf-demo-button bf-demo-primary" href="/sach">Tìm sách để mượn</a></div>{{/if}}
</section>
