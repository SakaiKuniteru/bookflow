<section class="bf-public-page bf-demo-customer-page">
    <header class="bf-demo-customer-heading">
        <div>
            <p class="bf-public-eyebrow">Tủ sách cá nhân</p>
            <h1>Mượn &amp; thuê sách</h1>
            <p>Chọn sách để gửi yêu cầu; nhân viên sẽ xác nhận và bàn giao tại chi nhánh.</p>
        </div>
        <a class="bf-demo-button bf-demo-primary" href="/sach?loai=muon">＋&nbsp; Tìm sách để mượn</a>
    </header>
    {{#if requests}}
        <div class="bf-demo-loan-list">
            {{#each requests}}
                <article class="bf-demo-loan-card">
                    <span class="bf-demo-mini-cover">✦</span>
                    <div>
                        <strong>{{this.tenSach}}</strong>
                        <small>{{this.maPhieuMuon}} · {{this.hinhThucHienThi}} · Chi nhánh {{this.tenChiNhanh}}</small>
                        <small>Ngày yêu cầu: {{formatDate this.ngayTao}} · Hẹn trả: {{formatDate this.hanTra}}</small>
                    </div>
                    <div class="bf-demo-loan-status">
                        <span class="bf-demo-status">{{#if this.trangThaiHienThi}}{{this.trangThaiHienThi}}{{else}}Đang mượn{{/if}}</span>
                        <small>{{#if this.phiHienThi}}{{this.phiHienThi}}{{else}}Mượn miễn phí{{/if}}</small>
                    </div>
                </article>
            {{/each}}
        </div>
    {{else}}
        <div class="bf-demo-empty">
            <span>▤</span>
            <h2>Bạn chưa có yêu cầu mượn</h2>
            <p>Sách mượn và thuê của bạn sẽ được theo dõi tại đây.</p>
            <a class="bf-demo-button bf-demo-primary" href="/sach">Tìm sách để mượn</a>
        </div>
    {{/if}}
</section>