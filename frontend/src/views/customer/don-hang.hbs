<section class="bf-public-page bf-demo-customer-page"><header class="bf-demo-customer-heading"><div><h1>Đơn mua của tôi</h1><p>Kiểm tra các đơn đã đặt tại BookFlow.</p></div></header>
    {{#if orders}}<div class="bf-demo-order-list">{{#each orders}}<article class="bf-demo-order-card"><header><div><strong>{{this.ma_don_hang}}</strong><small>{{#if this.ngay_tao}}{{formatDate this.ngay_tao}}{{/if}}{{#if this.ten_chi_nhanh}} · Chi nhánh {{this.ten_chi_nhanh}}{{/if}}</small></div><span class="bf-demo-status">{{#if this.trang_thai_hien_thi}}{{this.trang_thai_hien_thi}}{{else}}Đang xử lý{{/if}}</span></header>{{#each this.chi_tiet}}<div class="bf-demo-order-line"><span class="bf-demo-mini-cover">✦</span><div><strong>{{this.ten_sach}}</strong><small>{{this.so_luong}} cuốn × {{this.don_gia_hien_thi}}</small></div><b>{{this.thanh_tien_hien_thi}}</b></div>{{/each}}<footer><span>Thanh toán khi nhận</span><strong>{{this.tong_tien_hien_thi}}</strong></footer></article>{{/each}}</div>{{else}}<div class="bf-demo-empty"><span>▤</span><h2>Bạn chưa có đơn hàng</h2><p>Những đơn mua sách của bạn sẽ xuất hiện tại đây.</p><a class="bf-demo-button bf-demo-primary" href="/sach">Khám phá sách</a></div>{{/if}}
</section>
