<section class="bf-public-page bf-demo-customer-page">
    <header class="bf-demo-customer-heading">
        <div>
            <h1>Đơn mua của tôi</h1>
            <p>Kiểm tra các đơn đã đặt tại BookFlow.</p>
        </div>
    </header>
    {{#if orders}}
        <div class="bf-demo-order-list">
            {{#each orders}}
                <article class="bf-demo-order-card">
                    <header>
                        <div>
                            <strong>{{this.maDonHang}}</strong>
                            <small>{{#if this.ngayTao}}{{formatDate this.ngayTao}}{{/if}}{{#if this.tenChiNhanh}} · Chi nhánh {{this.tenChiNhanh}}{{/if}}</small>
                        </div>
                        <span class="bf-demo-status">{{#if this.trangThaiHienThi}}{{this.trangThaiHienThi}}{{else}}Đang xử lý{{/if}}</span>
                    </header>
                    {{#each this.chiTiet}}
                        <div class="bf-demo-order-line">
                            <span class="bf-demo-mini-cover">✦</span>
                            <div>
                                <strong>{{this.tenSach}}</strong>
                                <small>{{this.soLuong}} cuốn × {{this.donGiaHienThi}}</small>
                            </div>
                            <b>{{this.thanhTienHienThi}}</b>
                        </div>
                    {{/each}}
                    <footer>
                        <span>Thanh toán khi nhận</span>
                        <strong>{{this.tongTienHienThi}}</strong>
                    </footer>
                </article>
            {{/each}}
        </div>
    {{else}}
        <div class="bf-demo-empty">
            <span>▤</span>
            <h2>Bạn chưa có đơn hàng</h2>
            <p>Những đơn mua sách của bạn sẽ xuất hiện tại đây.</p>
            <a class="bf-demo-button bf-demo-primary" href="/sach">Khám phá sách</a>
        </div>
    {{/if}}
</section>
