<section class="bf-public-page bf-demo-customer-page">
    <header class="bf-demo-customer-heading">
        <div>
            <p class="bf-public-eyebrow">Giỏ hàng</p>
            <h1>Sách bạn đã chọn</h1>
            <p>Đặt mua và nhận tại chi nhánh hoặc địa chỉ của bạn.</p>
        </div>
        <a class="bf-demo-button" href="/sach">→&nbsp; Tiếp tục xem sách</a>
    </header>
    {{#if cart.items}}
        <div class="bf-demo-customer-panel">
            {{#each cart.items}}
                <article class="bf-demo-cart-row">
                    <span class="bf-demo-mini-cover">✦</span>
                    <div>
                        <strong>{{this.ten_sach}}</strong>
                        <small>{{this.so_luong}} cuốn · {{this.gia_hien_thi}}</small>
                    </div>
                    <b>{{this.thanh_tien_hien_thi}}</b>
                </article>
            {{/each}}
            <div class="bf-demo-cart-total">
                <span>Tổng cộng</span>
                <strong>{{cart.tong_tien_hien_thi}}</strong>
            </div>
            <a class="bf-demo-button bf-demo-primary" href="/customer/thanh-toan">Tiến hành đặt mua</a>
        </div>
    {{else}}
        <div class="bf-demo-empty">
            <span>▤</span>
            <h2>Giỏ hàng đang trống</h2>
            <p>Thêm vài cuốn sách bạn yêu thích nhé.</p>
            <a class="bf-demo-button bf-demo-primary" href="/sach">Khám phá sách</a>
        </div>
    {{/if}}
</section>