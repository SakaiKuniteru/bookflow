NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Đặt cùng giá trị với APP_NAME/APP_LOGO_URL trong .env gốc.
APP_NAME=BookFlow
APP_LOGO_URL=/brand/logo-symbol.svg
APP_URL=http://localhost:3000

BACKEND_API_URL=http://localhost:3001/api
BACKEND_API_TIMEOUT=15000

AUTH_COOKIE_NAME=bookflow_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE=86400000

SESSION_COOKIE_HTTP_ONLY=true

VIEW_CACHE=false

SESSION_SECRET=<kết quả lệnh đầu>
REDIS_URL=<URL Redis của môi trường frontend>
REGISTRATION_DRAFT_KEY=<kết quả lệnh thứ hai>
