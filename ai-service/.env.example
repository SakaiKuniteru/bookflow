APP_NAME=BookFlow AI Service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=false
APP_LOG_LEVEL=INFO

BACKEND_BASE_URL=http://localhost:3000
BACKEND_INTERNAL_TOKEN=
BACKEND_REQUEST_TIMEOUT=30

DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

REDIS_URL=redis://localhost:6379/0

LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=60

# gemini uses Google's native API and requests the configured vector size.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT=60

AI_MAX_CONTEXT_LENGTH=12000
AI_MAX_RESPONSE_TOKENS=2000
AI_TEMPERATURE=0.2

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=bookflow-ai

WORKER_ENABLED=false
WORKER_CONCURRENCY=2

AI_TOOLS_ENABLED=false
AI_ASSISTANT_TIMEOUT=60
QUEUE_NAME=bookflow:ai
WORKER_POLL_TIMEOUT=5
WORKER_HEARTBEAT_INTERVAL=15
EMBEDDING_TIMEOUT=60
