# F00.1: chỉ là ví dụ; không đặt mật khẩu/khóa thật trong file này.
APP_ENV=dev
COMPOSE_PROJECT_NAME=bookflow

# Image và tag dành cho Compose/CI ở bước triển khai tiếp theo.
BOOKFLOW_IMAGE_TAG=dev
FRONTEND_IMAGE=bookflow/frontend
BACKEND_IMAGE=bookflow/backend
AI_API_IMAGE=bookflow/ai-api
AI_WORKER_IMAGE=bookflow/ai-worker

# Cổng Nginx dự kiến trên máy phát triển; chưa có Compose để sử dụng.
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Cấu hình chung dự kiến.
LOG_LEVEL=debug
TZ=UTC

# F02 - image hạ tầng
PGVECTOR_IMAGE=pgvector/pgvector:0.8.6-pg17-bookworm
REDIS_IMAGE=redis:7.4.5-alpine
MINIO_IMAGE=rustfs/rustfs:1.0.0-rc.6

# PostgreSQL
POSTGRES_USER=bookflow
POSTGRES_DB=bookflow_dev
POSTGRES_PASSWORD=

# Kết nối migration runner từ máy Mac
DB_HOST=127.0.0.1
DB_PORT=15432

# Redis
REDIS_PASSWORD=
REDIS_PORT=16379

# MinIO
MINIO_ROOT_USER=bookflowadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

PORT=3001
REDIS_HOST=127.0.0.1
STORAGE_ENDPOINT=http://127.0.0.1:19000
STORAGE_HEALTH_URL=http://127.0.0.1:19000/health